{
  "name": "opencode-go-multi-auth",
  "version": "0.2.1",
  "description": "OpenCode V2 plugin for multi-account OpenCode Go provider aliases",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "server.js"
  ],
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-go",
    "multi-auth",
    "plugin"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.24"
  }
}
